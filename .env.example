# Copy to .env.local to override defaults for your machine. Never commit secrets.

# Origin of the API. Empty = same origin (recommended).
VITE_API_BASE_URL=

# Dev server only (vite --mode real): where /api is proxied.
# http://localhost:8080 = gateway (default). http://localhost:8081 = catalog-service directly.
VITE_PROXY_TARGET=http://localhost:8080

# true | false
VITE_USE_MOCKS=true

# demo | anonymous | oidc
VITE_AUTH_MODE=demo

VITE_OIDC_AUTHORITY=http://localhost:8180/realms/auramart
VITE_OIDC_CLIENT_ID=auramart-web

# Link on the About page.
VITE_REPO_URL=https://github.com/your-github-username/auramart
